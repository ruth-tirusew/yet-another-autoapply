{% if resume.education %}
<h2>{{ section_title or 'Education' }}</h2>
{% for e in resume.education %}
<div class="entry">
<h3>{{ e.institution or '' }}{% if e.studyType or e.area %} <span class="org">— {{ e.studyType or '' }} {{ e.area or '' }}</span>{% endif %}</h3>
{% if e.startDate or e.endDate %}<p class="meta">{{ e.startDate or '' }}{% if e.startDate or e.endDate %} – {% endif %}{{ e.endDate or 'Present' }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
