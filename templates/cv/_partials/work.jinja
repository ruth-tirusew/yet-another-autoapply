{% if resume.work %}
<h2>{{ section_title or 'Experience' }}</h2>
{% for w in resume.work %}
<h3>{{ w.position or '' }}{% if w.name %} — {{ w.name }}{% endif %}</h3>
<p class="meta">{{ w.startDate or '' }}{% if w.startDate or w.endDate %} – {% endif %}{{ w.endDate or 'Present' }}</p>
{% if w.summary %}<p>{{ w.summary }}</p>{% endif %}
{% if w.highlights %}<ul>{% for h in w.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
{% endfor %}
{% elif resume.projects %}
<h2>{{ section_title or 'Experience' }}</h2>
{% for p in resume.projects %}
<h3>{{ p.name or 'Project' }}</h3>
{% if p.startDate or p.endDate %}<p class="meta">{{ p.startDate or '' }}{% if p.startDate or p.endDate %} – {% endif %}{{ p.endDate or 'Present' }}</p>{% endif %}
{% if p.description %}<p>{{ p.description }}</p>{% endif %}
{% if p.highlights %}<ul>{% for h in p.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
{% if p.technologies %}<p class="meta">{{ p.technologies|join(', ') }}</p>{% endif %}
{% endfor %}
{% endif %}
